# ==============================================================================
# Artho AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js Express server (Render sets PORT automatically)
PORT=3000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV="development"

# Application public URL (used for CORS, links, and health checks)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database Configuration (REQUIRED for persistence)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster replica set or local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Target MongoDB database name (default: 'arthobachao')
MONGODB_DB_NAME="arthobachao"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, use a high-entropy 64+ character random string
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Optional flag: Allow demo user auto-seeding in production mode ('true' or 'false')
# Defaults to true in development, false in production
ENABLE_DEMO_USER="false"

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Integration (REQUIRED for AI Financial Coach)
# ------------------------------------------------------------------------------
# API key obtained from Google AI Studio (https://aistudio.google.com/)
# Used server-side only; never exposed to the frontend client bundle
GEMINI_API_KEY="your_google_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 5. Email & OTP Verification (OPTIONAL / FEATURE FLAGS)
# ------------------------------------------------------------------------------
# Email OTP Verification Control:
# - Set to "true" to require 6-digit email OTP verification on registration and login.
# - Set to "false" (or "disabled"/"0") to temporarily bypass email OTP verification
#   (useful when transactional email domain is not yet configured).
EMAIL_OTP_ENABLED="false"

# Active email provider: "brevo", "smtp", or "resend"
# Default: "smtp"
EMAIL_PROVIDER="smtp"

# Sender address displayed in verification emails
EMAIL_FROM="Artho AI <no-reply@arthoai.com>"

# Provider Option A: Gmail / Standard SMTP (Nodemailer)
# Note: Render Free tier blocks outbound SMTP port 465/587; use Brevo on Render Free.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Provider Option B: Brevo API (Recommended for Render Free over HTTPS Port 443)
# BREVO_API_KEY="xkeysib-your_brevo_api_key_here"

# Provider Option C: Resend API (Requires verified custom sender domain)
# RESEND_API_KEY="re_your_resend_api_key_here"
