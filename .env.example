# ==============================================================================
# ArthoBachao AI — Environment Variables Configuration Template
# NOTE: Replace placeholder values below with your real credentials in your local .env file.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="development"

# MongoDB Database Persistence (MongoDB Atlas)
# Explicit database name default is 'arthobachao'
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="arthobachao"

# Authentication & Security
# Generate a secure 64-character random string for production
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Google Gemini API
# Required for ArthoBachao AI Financial Coach intelligence
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Application Public URL
# Used for self-referential links, OAuth callbacks, and API endpoints
APP_URL="http://localhost:3000"

# Transactional Email Delivery (Gmail SMTP - Primary / No Domain Required)
# Generates a 16-character Google App Password from Google Account Security (with 2-Step Verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="ArthoBachao AI <your_email@gmail.com>"

# Provider selection: "smtp" (recommended) or "resend"
EMAIL_PROVIDER="smtp"

# Optional Secondary Provider: Resend API (requires verified custom domain for arbitrary recipients)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
# EMAIL_FROM="ArthoBachao AI <onboarding@resend.dev>"
