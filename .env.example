# ==============================================================================
# ArthoBachao AI — Environment Variables Configuration Template
# NOTE: Replace placeholder values below with your real credentials in your local .env file.
# NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="development"

# MongoDB Database Persistence (MongoDB Atlas)
# Explicit database name default is 'arthobachao'
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="arthobachao"

# Authentication & Security
# Generate a secure 64-character random string for production
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Google Identity Services (OAuth 2.0 Web Client)
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Add http://localhost:3000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Email Verification Service (SMTP Relay)
# Optional in development (defaults to structured console logging with OTP display)
# Configure for real production email delivery (e.g. Amazon SES, SendGrid, Mailgun, Brevo, Gmail SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey_or_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@arthobachao.ai"

# Google Gemini API
# Required for ArthoBachao AI Financial Coach intelligence
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Application Public URL
# Used for self-referential links, OAuth callbacks, and API endpoints
APP_URL="http://localhost:3000"
